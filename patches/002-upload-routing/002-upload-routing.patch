+    () => ({
+      endpoint,
+      endpointType,
+      provider,
+      useResponsesApi,
+      contextCapabilityEnabled: capabilities.contextEnabled,
+      fileSearchCapabilityEnabled: capabilities.fileSearchEnabled,
+      codeCapabilityEnabled: capabilities.codeEnabled,
+      fileSearchAllowedByAgent,
+      codeAllowedByAgent,
+      specUploadMethods,
+      endpointUploadMethods,
+    }),
+    [
+      endpoint,
+      endpointType,
+      provider,
+      useResponsesApi,
+      capabilities.contextEnabled,
+      capabilities.fileSearchEnabled,
+      capabilities.codeEnabled,
+      fileSearchAllowedByAgent,
+      codeAllowedByAgent,
+      specUploadMethods,
+      endpointUploadMethods,
+    ],
+  );
