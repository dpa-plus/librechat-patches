+      const a = { name: 'a.pdf', type: 'application/pdf' };
+      const b = { name: 'b.pdf', type: 'application/pdf' };
+      const { groups } = groupRoutedFiles(
+        [a, b].map((file) => ({ file, option: resolveUploadForFile(file, base) })),
+      );
+      expect(groups).toHaveLength(1);
+      expect(groups[0].files).toEqual([a, b]);
+    });
+
+    it('separates out what nothing can take', () => {
+      const good = { name: 'a.pdf', type: 'application/pdf' };
+      const bad = { name: 'b.pdf', type: 'application/pdf' };
+      const { groups, rejected } = groupRoutedFiles([
+        { file: good, option: { type: UploadOptionType.provider } },
+        { file: bad, option: null },
+      ]);
+      expect(rejected).toEqual([bad]);
+      expect(groups).toHaveLength(1);
+    });
+  });
+});
