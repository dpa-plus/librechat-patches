+    });
+
+    act(() => dropSpec?.drop({ files: [png()] }));
+
+    expect(mockHandleFiles).not.toHaveBeenCalled();
+    expect(mockShowToast).toHaveBeenCalledWith({
+      message: 'com_ui_upload_no_options',
+      status: 'error',
+    });
+  });
+
+  it('still opens the dialog when only a tool-backed option survives', () => {
+    mockAgentPermissions = {
+      fileSearchAllowedByAgent: true,
+      codeAllowedByAgent: false,
+      provider: undefined,
+    };
+    const { result } = setup({
+      uploadMethods: { provider: false },
+      capabilities: [AgentCapabilities.file_search],
+    });
+
+    act(() => dropSpec?.drop({ files: [csv()] }));
+
+    expect(mockShowToast).not.toHaveBeenCalled();
+    expect(result.current.showModal).toBe(true);
+  });
+
+  it('keeps the direct upload path for the assistants endpoint', () => {
+    const files = [png()];
+    setup({ endpoint: EModelEndpoint.assistants });
+
+    act(() => dropSpec?.drop({ files }));
+
+    expect(mockHandleFiles).toHaveBeenCalledWith(files);
