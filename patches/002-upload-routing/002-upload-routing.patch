+
+      act(() => dropSpec?.drop({ files: [png()] }));
+
+      /** Fail-open would upload here; a false refusal would toast here. */
+      expect(mockHandleFiles).not.toHaveBeenCalled();
+      expect(mockShowToast).not.toHaveBeenCalled();
+      expect(result.current.showModal).toBe(false);
+    });
+
+    it('discards a waiting batch when the conversation changes, and says so', () => {
+      const { result, rerender } = setup({ fileConfigLoading: true });
+
+      act(() => dropSpec?.drop({ files: [png()] }));
+      expect(mockShowToast).not.toHaveBeenCalled();
+
+      /**
+       * The hooks stay mounted across a conversation switch. Resolving the
+       * batch now would combine conversation A's files with B's context and
+       * handlers and upload them into the wrong conversation.
+       */
+      mockDragDropContext = { ...mockDragDropContext, conversationId: 'convo-2' };
+      mockFileConfigData = {};
+      act(() => rerender());
+
+      expect(mockHandleFiles).not.toHaveBeenCalled();
+      expect(result.current.showModal).toBe(false);
+      expect(mockShowToast).toHaveBeenCalledWith({
+        message: 'com_ui_upload_cancelled_convo_switch',
+        status: 'error',
+      });
+    });
+
+    it('extends a waiting batch instead of replacing it on a second drop', () => {
+      const { result, rerender } = setup({ fileConfigLoading: true });
+
+      act(() => dropSpec?.drop({ files: [png()] }));
+      act(() => dropSpec?.drop({ files: [file('doc.pdf', 'application/pdf')] }));
+
+      mockFileConfigData = {};
+      act(() => rerender());
+
+      /** Both drops reach the dialog — the first one was not silently lost. */
+      expect(result.current.showModal).toBe(true);
+      expect(result.current.draggedFiles).toHaveLength(2);
+    });
+
+    it('opens the dialog once a config that allows the drop arrives', () => {
+      const { result, rerender } = setup({ fileConfigLoading: true });
+
+      act(() => dropSpec?.drop({ files: [png()] }));
+      expect(result.current.showModal).toBe(false);
+
+      mockFileConfigData = {};
+      act(() => rerender());
+
+      expect(result.current.showModal).toBe(true);
+      expect(result.current.draggedFiles).toHaveLength(1);
+      expect(mockShowToast).not.toHaveBeenCalled();
+      expect(mockHandleFiles).not.toHaveBeenCalled();
+    });
+
+    it('rejects once a config that removes every option arrives', () => {
+      const { result, rerender } = setup({
+        fileConfigLoading: true,
+        uploadMethods: { provider: false },
+      });
+
+      act(() => dropSpec?.drop({ files: [png()] }));
+      expect(mockShowToast).not.toHaveBeenCalled();
+
+      mockFileConfigData = {};
+      act(() => rerender());
+
+      expect(mockHandleFiles).not.toHaveBeenCalled();
+      expect(result.current.showModal).toBe(false);
+      expect(mockShowToast).toHaveBeenCalledWith({
+        message: 'com_ui_upload_no_options',
+        status: 'error',
+      });
+    });
+
+    it('stops waiting and rejects when the config query gives up', () => {
+      const { result, rerender } = setup({ fileConfigLoading: true });
+
+      act(() => dropSpec?.drop({ files: [png()] }));
+      expect(mockShowToast).not.toHaveBeenCalled();
+
+      mockFileConfigFailed = true;
+      act(() => rerender());
+
+      /** Waiting forever would strand the drop; uploading would be fail-open. */
+      expect(mockHandleFiles).not.toHaveBeenCalled();
+      expect(result.current.showModal).toBe(false);
+      expect(mockShowToast).toHaveBeenCalledWith({
+        message: 'com_ui_upload_no_options',
+        status: 'error',
+      });
+    });
+
+    it('waits for the startup config too when a model spec is active', () => {
+      /** `mockStartupConfig` stays undefined, so the spec level is unknown. */
+      mockDragDropContext = {
+        conversationId: 'convo-1',
+        endpoint: EModelEndpoint.openAI,
+        spec: 'some-spec',
+        endpointFileConfig: {} as EndpointFileConfig,
