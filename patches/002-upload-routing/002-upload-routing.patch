+++ b/client/src/hooks/Files/useRoutedUpload.ts
@@ -0,0 +1,141 @@
+import { useCallback } from 'react';
+import { useToastContext } from '@librechat/client';
+import { megabyte, EToolResources, groupRoutedFiles } from 'librechat-data-provider';
+import type { SetterOrUpdater } from 'recoil';
+import type * as t from 'librechat-data-provider';
+import type { RoutedFile } from './useUploadOptions';
+import useLocalize from '../useLocalize';
+
+interface UseRoutedUploadParams {
+  handleFiles: (files: File[], toolResource?: string) => Promise<void> | void;
+  setEphemeralAgent: SetterOrUpdater<t.TEphemeralAgent | null>;
+  setFilesLoading?: (loading: boolean) => void;
+  /** Already-attached files, so the limits can be checked across all groups. */
+  currentFileCount?: number;
+  fileLimit?: number;
+  /** Bytes already attached, so the size limit spans groups the same way. */
+  currentTotalSizeBytes?: number;
+  /** In bytes (the merged config converts MB on the way in), like `validateFiles`. */
+  totalSizeLimit?: number;
+}
+
+/**
+ * Uploads an already-routed set of files, one call per method.
+ *
+ * Shared by the three entry points that can route: the file picker, a drop and
+ * the clipboard. They had three copies of this, and the copies drifted — the
+ * clipboard one forgot to arm the ephemeral agent, which uploads a file to a
+ * tool the agent is not holding. It looks like it worked and the file is gone.
+ */
+export default function useRoutedUpload({
+  handleFiles,
+  setEphemeralAgent,
+  setFilesLoading,
+  currentFileCount = 0,
+  fileLimit,
+  currentTotalSizeBytes = 0,
+  totalSizeLimit,
+}: UseRoutedUploadParams) {
+  const { showToast } = useToastContext();
+  const localize = useLocalize();
+
+  return useCallback(
+    async (routed: RoutedFile[]) => {
+      const { groups, rejected } = groupRoutedFiles(routed);
+
+      if (rejected.length > 0) {
+        showToast({
+          message:
+            groups.length > 0
+              ? localize('com_ui_upload_no_options_partial', {
+                  0: rejected.map((file) => file.name).join(', '),
+                })
+              : localize('com_ui_upload_no_options'),
+          status: 'error',
+        });
+      }
+
+      if (groups.length === 0) {
+        /**
+         * Nothing was rejected either, so the caller handed over an empty set —
+         * which happens when the configuration turned out to be unavailable.
+         * Saying so beats returning quietly and losing the files in silence.
+         */
+        if (rejected.length === 0) {
+          showToast({ message: localize('com_ui_upload_no_options'), status: 'error' });
+        }
+        setFilesLoading?.(false);
+        return;
+      }
+
+      /**
+       * `validateFiles` counts against the files already in state, and the
+       * `handleFiles` this loop calls carries the list it closed over. Awaiting
+       * the groups does not refresh it, so each group would be measured against
+       * the same starting point and `fileLimit` would apply per group instead of
+       * per drop. Checked once, over everything, before any of it goes out.
+       */
+      const total = groups.reduce((n, group) => n + group.files.length, 0);
+      if (fileLimit != null && currentFileCount + total > fileLimit) {
+        showToast({ message: `File limit reached: ${fileLimit} files`, status: 'error' });
+        setFilesLoading?.(false);
+        return;
+      }
+
+      /**
+       * Same closure problem, same cure, for bytes: `validateFiles` measures
+       * `totalSizeLimit` against the files already in state, so each group of a
+       * split selection would be measured from the same starting point and the
+       * limit would hold per group instead of over the whole drop. Checked once
+       * here, over every group plus what is already attached.
+       */
+      const totalBytes = groups.reduce(
+        (n, group) => n + group.files.reduce((bytes, file) => bytes + file.size, 0),
+        0,
+      );
+      if (totalSizeLimit != null && totalSizeLimit > 0 && currentTotalSizeBytes + totalBytes > totalSizeLimit) {
+        showToast({
+          message: `Total file size limit exceeded: ${totalSizeLimit / megabyte} MB`,
+          status: 'error',
+        });
+        setFilesLoading?.(false);
+        return;
+      }
+
+      setFilesLoading?.(true);
+
+      /**
+       * Sequential on purpose. `validateFiles` counts against the files already
+       * in state, and `addFile` lands asynchronously — firing the groups off
+       * together would let every one of them see an empty list and walk past
+       * `fileLimit` and `totalSizeLimit` a group at a time.
+       */
+      try {
+        for (const group of groups) {
+          if (
+            group.toolResource === EToolResources.file_search ||
+            group.toolResource === EToolResources.execute_code
+          ) {
+            const toolResource = group.toolResource;
+            setEphemeralAgent((prev) => ({ ...prev, [toolResource]: true }));
+          }
+          await handleFiles(group.files, group.toolResource);
+        }
+      } catch (error) {
+        console.error('routed upload failed', error);
+        setFilesLoading?.(false);
+      }
+    },
+    [
+      handleFiles,
+      setEphemeralAgent,
+      setFilesLoading,
+      showToast,
+      localize,
+      currentFileCount,
+      fileLimit,
+      currentTotalSizeBytes,
+      totalSizeLimit,
+    ],
+  );
+}
