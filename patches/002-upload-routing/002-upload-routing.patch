+import { useMemo } from 'react';
+import type { EndpointFileConfig, TUploadMethods } from 'librechat-data-provider';
+import { useGetStartupConfig, useGetFileConfig } from '~/data-provider';
+
+export interface UploadMethodsSources {
+  /** `uploadMethods` of the active model spec, if the conversation has one. */
+  specUploadMethods?: TUploadMethods;
+  /** `uploadMethods` of the resolved endpoint's file config. */
+  endpointUploadMethods?: TUploadMethods;
+  /**
+   * `false` while at least one source these two values are derived from has not
+   * arrived yet. Both sources are then indistinguishable from "nothing
+   * configured", which resolves to *enabled* — so a caller that treats a
+   * not-yet-known config as a known one offers and executes upload methods the
+   * configuration removes. Callers must not derive an offer from this hook while
+   * it is `false`.
+   */
+  isReady: boolean;
+  /**
+   * The configuration will not arrive at all — a query gave up with an error.
+   * Also `isReady: false`, but a permanent one: callers that are waiting for a
+   * decision have to stop waiting and reject, instead of leaving the user with a
+   * spinner that never resolves.
+   */
+  isUnavailable: boolean;
+}
+
+/**
+ * Looks up the two `uploadMethods` sources for the current conversation.
+ *
+ * Resolution itself (spec beats endpoint beats enabled) happens inside
+ * {@link getAvailableUploadOptions}, so that every caller resolves identically.
+ * This hook only knows where the two levels come from, and whether they are
+ * known yet.
+ */
+export default function useUploadMethods({
+  spec,
+  endpointFileConfig,
+}: {
+  spec?: string | null;
+  endpointFileConfig?: EndpointFileConfig | null;
+}): UploadMethodsSources {
+  const { data: startupConfig, isError: startupConfigFailed } = useGetStartupConfig();
+  /**
+   * Read only for its load state. The value itself reaches this hook as
+   * `endpointFileConfig`, already resolved for the endpoint by the caller; both
+   * observers watch the same query key, so they settle in the same render.
+   */
+  const { data: fileConfigData, isError: fileConfigFailed } = useGetFileConfig();
+  const modelSpecs = startupConfig?.modelSpecs?.list;
+
+  const endpointUploadMethods = endpointFileConfig?.uploadMethods;
+
+  return useMemo(() => {
+    const specUploadMethods = spec
+      ? modelSpecs?.find((modelSpec) => modelSpec.name === spec)?.uploadMethods
+      : undefined;
+
+    /**
+     * The startup config only matters when a spec has to be looked up in it;
+     * without a spec its load state cannot change the outcome.
+     *
+     * A failed query keeps `data` undefined and therefore keeps this `false`.
+     * That is deliberate: an error means the configuration is unknown, not that
+     * it is empty, and offering an upload method on an unknown configuration is
+     * exactly the hole this flag closes.
+     */
+    const isReady = fileConfigData !== undefined && (!spec || startupConfig !== undefined);
+    const isUnavailable =
+      !isReady && (fileConfigFailed === true || (!!spec && startupConfigFailed === true));
+
+    return { specUploadMethods, endpointUploadMethods, isReady, isUnavailable };
+  }, [
+    spec,
+    modelSpecs,
+    endpointUploadMethods,
+    fileConfigData,
+    startupConfig,
+    fileConfigFailed,
+    startupConfigFailed,
+  ]);
+}
