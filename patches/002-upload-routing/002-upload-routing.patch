+beforeEach(() => {
+  dropSpec = undefined;
+  mockShowToast.mockClear();
+  mockHandleFiles.mockClear();
+  mockFileConfigData = {};
+  mockFileConfigFailed = false;
+  mockAgentPermissions = {
+    fileSearchAllowedByAgent: false,
+    codeAllowedByAgent: false,
+    provider: undefined,
