+import React from 'react';
+import { RecoilRoot } from 'recoil';
+import { act, renderHook } from '@testing-library/react';
+import { AgentCapabilities, EModelEndpoint } from 'librechat-data-provider';
+import type { EndpointFileConfig, TUploadMethods } from 'librechat-data-provider';
+import useDragHelpers from '../useDragHelpers';
+
+/**
+ * Regression suite for the drag-and-drop path.
+ *
+ * `useDragHelpers` used to derive its own "should a dialog open?" condition
+ * without knowing about `uploadMethods`, so a drop could upload files past a
+ * configuration that the attachment menu and the drop dialog both honoured.
+ */
+
+interface DropSpec {
+  drop: (item: { files: File[] }) => void;
+}
+
+let dropSpec: DropSpec | undefined;
+
+jest.mock('react-dnd', () => ({
+  useDrop: (specFactory: () => DropSpec) => {
+    dropSpec = specFactory();
+    return [{ canDrop: false, isOver: false }, jest.fn()];
+  },
+}));
+
+jest.mock('react-dnd-html5-backend', () => ({
+  NativeTypes: { FILE: '__NATIVE_FILE__' },
+}));
+
+const mockShowToast = jest.fn();
+jest.mock('@librechat/client', () => ({
+  useToastContext: () => ({ showToast: mockShowToast }),
+}));
+
+const mockGetQueryData = jest.fn(() => undefined);
+jest.mock('@tanstack/react-query', () => ({
+  useQueryClient: () => ({ getQueryData: mockGetQueryData }),
+}));
+
+const mockHandleFiles = jest.fn();
+jest.mock('../useFileHandling', () => ({
+  __esModule: true,
+  default: () => ({ handleFiles: mockHandleFiles }),
+}));
+
+jest.mock('~/hooks/useLocalize', () => ({
+  __esModule: true,
+  default: () => (key: string) => key,
+}));
+
+let mockDragDropContext: Record<string, unknown> = {};
+jest.mock('~/Providers', () => ({
+  useDragDropContext: () => mockDragDropContext,
+}));
+
+let mockAgentsCapabilities: AgentCapabilities[] = [];
+jest.mock('~/hooks/Agents/useGetAgentsConfig', () => ({
+  __esModule: true,
+  default: () => ({ agentsConfig: { capabilities: mockAgentsCapabilities } }),
+}));
+
+let mockAgentPermissions = {
+  fileSearchAllowedByAgent: false,
+  codeAllowedByAgent: false,
+  provider: undefined as string | undefined,
+};
+jest.mock('~/hooks/Agents/useAgentToolPermissions', () => ({
+  __esModule: true,
+  default: () => mockAgentPermissions,
+}));
+
+let mockStartupConfig: Record<string, unknown> | undefined;
+/** `undefined` models the window in which the file-config query is still in flight. */
+let mockFileConfigData: Record<string, unknown> | undefined = {};
+let mockFileConfigFailed = false;
+jest.mock('~/data-provider', () => ({
+  useGetStartupConfig: () => ({ data: mockStartupConfig }),
+  useGetFileConfig: () => ({ data: mockFileConfigData, isError: mockFileConfigFailed }),
+}));
+
+const wrapper = ({ children }: { children: React.ReactNode }) => (
+  <RecoilRoot>{children}</RecoilRoot>
+);
+
+const file = (name: string, type: string) => ({ name, type }) as File;
+const png = () => file('photo.png', 'image/png');
+const csv = () => file('table.csv', 'text/csv');
+
+const setup = ({
+  endpoint = EModelEndpoint.openAI as string,
+  endpointType,
+  uploadMethods,
+  spec,
+  specUploadMethods,
+  capabilities = [] as AgentCapabilities[],
+  fileConfigLoading = false,
+}: {
+  endpoint?: string;
+  endpointType?: string;
+  uploadMethods?: TUploadMethods;
+  spec?: string;
+  specUploadMethods?: TUploadMethods;
+  capabilities?: AgentCapabilities[];
+  fileConfigLoading?: boolean;
+} = {}) => {
+  mockAgentsCapabilities = capabilities;
+  mockDragDropContext = {
+    conversationId: 'convo-1',
+    agentId: undefined,
+    endpoint,
+    endpointType,
+    useResponsesApi: undefined,
+    spec,
+    endpointFileConfig: { uploadMethods } as EndpointFileConfig,
+  };
+  mockStartupConfig =
+    spec != null
+      ? { modelSpecs: { list: [{ name: spec, uploadMethods: specUploadMethods }] } }
+      : undefined;
+  mockFileConfigData = fileConfigLoading ? undefined : {};
