@@ -0,0 +1,290 @@
+import { EToolResources } from './types/assistants';
+import { EModelEndpoint, Providers, isDocumentSupportedProvider } from './schemas';
+import {
+  inferMimeType,
+  isAutoRouteEnabled,
+  isBedrockDocumentType,
+  isUploadMethodEnabled,
+} from './file-config';
+import type { TUploadMethods } from './file-config';
+
+/**
+ * The upload options the attachment menu and the drag-and-drop dialog can offer.
+ *
+ * `provider` and `image` are the two shapes of the same direct branch — hand the
+ * raw file to the model. Which of the two applies depends on whether the provider
+ * can read documents; they are mutually exclusive and both are governed by
+ * `uploadMethods.provider`.
+ */
+export enum UploadOptionType {
+  /** "Upload to Provider" — raw file, provider reads documents (and images). */
+  provider = 'provider',
+  /** "Upload Image" — raw file, provider reads images only. */
+  image = 'image',
+  /** "Upload as Text" — server extracts text/OCR first. */
+  context = 'context',
+  /** "Upload for File Search" — RAG. */
+  file_search = 'file_search',
+  /** "Upload to Code Environment". */
+  execute_code = 'execute_code',
+}
+
+/** Preset for the file input's `accept` attribute. */
+export type UploadFileType =
+  | 'image'
+  | 'document'
+  | 'image_document'
+  | 'image_document_extended'
+  | 'image_document_video_audio';
+
+export interface UploadOption {
+  type: UploadOptionType;
+  /** `tool_resource` to attach; `undefined` hands the file to the model directly. */
+  toolResource?: EToolResources;
+  /** MIME preset the file picker should apply for this option. */
+  fileType?: UploadFileType;
+}
+
+/** Minimal shape of a file; avoids depending on the DOM `File` type. */
+export interface UploadCandidateFile {
+  name: string;
+  type: string;
+}
+
+export interface UploadOptionsParams {
+  /** Conversation endpoint, e.g. `openAI` or a custom endpoint name. */
+  endpoint?: string | null;
+  /** Resolved endpoint type (`resolveEndpointType`). */
+  endpointType?: string | null;
+  /** Agent provider, when an agent is selected; takes precedence over `endpoint`. */
+  provider?: string | null;
+  useResponsesApi?: boolean;
+  /** Agent capabilities from `endpoints.agents.capabilities`. */
+  contextCapabilityEnabled?: boolean;
+  fileSearchCapabilityEnabled?: boolean;
+  codeCapabilityEnabled?: boolean;
+  /** Per-agent tool permissions (`useAgentToolPermissions`). */
+  fileSearchAllowedByAgent?: boolean;
+  codeAllowedByAgent?: boolean;
+  /** `uploadMethods` of the active model spec; wins over the endpoint level. */
+  specUploadMethods?: TUploadMethods | null;
+  /** `uploadMethods` of the resolved endpoint's `fileConfig`. */
+  endpointUploadMethods?: TUploadMethods | null;
+  /**
+   * The concrete files, when they are known (drag and drop). Options that cannot
+   * take all of these files are omitted. Pass nothing for the attachment menu,
+   * where the files are only chosen after the option.
+   */
+  files?: UploadCandidateFile[] | null;
+}
+
+/**
+ * Single source of truth for the upload options the conversation surface offers.
+ *
+ * Used by the attachment menu (no files), by the drop handler (with files, to
+ * decide whether a dialog opens at all) and by the drop dialog (with files, to
+ * render the list). Deriving these three separately is what allowed the
+ * `uploadMethods` opt-out to be bypassed by dropping files.
+ *
+ * Not every upload in the app passes through here: the assistants endpoints and
+ * the agent builder in the side panel upload without asking this function. See
+ * the SCOPE section on `uploadMethodsSchema` for what that means.
+ *
+ * `uploadMethods` can only remove options here, never add one: every entry still
+ * has to pass its own capability and permission check first. And it is a surface
+ * switch only — the server does not enforce it.
+ *
+ * An empty result means there is nothing to offer for these files; callers must
+ * reject the upload rather than fall back to uploading anyway.
+ */
+export function getAvailableUploadOptions(params: UploadOptionsParams): UploadOption[] {
+  const {
+    endpoint,
+    endpointType,
+    provider,
+    useResponsesApi,
+    contextCapabilityEnabled,
+    fileSearchCapabilityEnabled,
+    codeCapabilityEnabled,
+    fileSearchAllowedByAgent,
+    codeAllowedByAgent,
+    specUploadMethods,
+    endpointUploadMethods,
+    files,
+  } = params;
+
+  const providerEnabled = isUploadMethodEnabled(
+    'provider',
+    specUploadMethods,
+    endpointUploadMethods,
+  );
+  const contextEnabled = isUploadMethodEnabled('context', specUploadMethods, endpointUploadMethods);
+  const fileSearchEnabled = isUploadMethodEnabled(
+    'file_search',
+    specUploadMethods,
+    endpointUploadMethods,
+  );
+  const codeEnabled = isUploadMethodEnabled(
+    'execute_code',
+    specUploadMethods,
+    endpointUploadMethods,
+  );
+
+  let currentProvider = provider || endpoint;
+  // This will be removed in a future PR to formally normalize Providers comparisons to be case insensitive
+  if (currentProvider?.toLowerCase() === Providers.OPENROUTER) {
+    currentProvider = Providers.OPENROUTER;
+  }
+
+  const options: UploadOption[] = [];
+
+  /** `undefined`/`null` files means "not known yet", which never filters anything out. */
+  const acceptsAll = (predicate: (file: UploadCandidateFile) => boolean): boolean =>
+    files == null || files.every(predicate);
+
+  const getFileType = (file: UploadCandidateFile) => inferMimeType(file.name, file.type);
+
+  const isAzureWithResponsesApi =
+    (currentProvider === EModelEndpoint.azureOpenAI ||
+      endpointType === EModelEndpoint.azureOpenAI) &&
+    useResponsesApi === true;
+
+  /**
+   * `uploadMethods.provider` gates the entire direct branch. Putting it into the
+   * document-support condition instead would send a `provider: false` config down
+   * the `else` path and offer plain image upload — the same direct upload under a
+   * different label.
+   */
+  if (providerEnabled) {
+    const supportsDocuments =
+      isDocumentSupportedProvider(endpointType) ||
+      isDocumentSupportedProvider(currentProvider) ||
+      isAzureWithResponsesApi;
+
+    if (supportsDocuments) {
+      const supportsImageDocVideoAudio =
+        currentProvider === EModelEndpoint.google || currentProvider === Providers.OPENROUTER;
+      const isBedrock =
+        currentProvider === Providers.BEDROCK || endpointType === EModelEndpoint.bedrock;
+
+      let fileType: UploadFileType = 'image_document';
+      if (supportsImageDocVideoAudio) {
+        fileType = 'image_document_video_audio';
+      } else if (isBedrock) {
+        fileType = 'image_document_extended';
+      }
+
+      const isValidProviderFile = (file: UploadCandidateFile): boolean => {
+        const type = getFileType(file);
+        if (supportsImageDocVideoAudio) {
+          return (
+            type?.startsWith('image/') ||
+            type?.startsWith('video/') ||
+            type?.startsWith('audio/') ||
+            type === 'application/pdf'
+          );
+        }
+        if (isBedrock) {
+          return type?.startsWith('image/') || isBedrockDocumentType(type);
+        }
+        return type?.startsWith('image/') || type === 'application/pdf';
+      };
+
+      if (acceptsAll(isValidProviderFile)) {
+        options.push({ type: UploadOptionType.provider, fileType });
+      }
+    } else if (acceptsAll((file) => getFileType(file)?.startsWith('image/'))) {
+      options.push({ type: UploadOptionType.image, fileType: 'image' });
+    }
+  }
+
+  if (contextCapabilityEnabled === true && contextEnabled) {
+    options.push({ type: UploadOptionType.context, toolResource: EToolResources.context });
+  }
+
+  if (
+    fileSearchCapabilityEnabled === true &&
+    fileSearchAllowedByAgent === true &&
+    fileSearchEnabled
+  ) {
+    options.push({ type: UploadOptionType.file_search, toolResource: EToolResources.file_search });
+  }
+
+  if (codeCapabilityEnabled === true && codeAllowedByAgent === true && codeEnabled) {
+    options.push({
+      type: UploadOptionType.execute_code,
+      toolResource: EToolResources.execute_code,
+    });
+  }
+
+  return options;
+}
+
+/**
+ * The method a single file should take when the choice is made for the user.
+ *
+ * Precedence is the order {@link getAvailableUploadOptions} returns, which is the
+ * order the menu would have listed. A deployment that wants a different winner
+ * turns the loser off rather than reordering: that keeps one source of truth for
+ * "what is on offer here" instead of two.
+ *
+ * `null` means no method can take this file. Callers must reject it and say so —
+ * uploading anyway would walk past both the capability checks and the config.
+ */
+export function resolveUploadForFile(
+  file: UploadCandidateFile,
+  params: Omit<UploadOptionsParams, 'files'>,
+): UploadOption | null {
+  const options = getAvailableUploadOptions({ ...params, files: [file] });
+  return options[0] ?? null;
+}
+
+/**
+ * Whether the choice should be made for the user at all. Off unless configured,
+ * see `uploadMethodsSchema.autoRoute`.
+ */
+export function shouldAutoRoute(
+  params: Pick<UploadOptionsParams, 'specUploadMethods' | 'endpointUploadMethods'>,
+): boolean {
+  return isAutoRouteEnabled(params.specUploadMethods, params.endpointUploadMethods);
+}
+
+/**
+ * Groups already-routed files by the method they resolved to, and separates out
+ * the ones nothing can take.
+ *
+ * Grouping rather than uploading file by file is deliberate: the existing upload
+ * path validates and batches a whole list against one tool resource, and that
+ * logic (size limits, counts, per-resource rules) is worth reusing untouched.
+ * One call per distinct method keeps all of it, while still letting a
+ * spreadsheet and a PDF in the same drop take different paths.
+ *
+ * Generic over the file type so this stays free of DOM types and testable
+ * without a browser.
+ */
+export function groupRoutedFiles<T>(routed: Array<{ file: T; option: UploadOption | null }>): {
+  groups: Array<{ toolResource?: EToolResources; files: T[] }>;
+  rejected: T[];
+} {
+  const groups: Array<{ toolResource?: EToolResources; files: T[] }> = [];
+  const rejected: T[] = [];
+  /** `undefined` is a real key here — it means "straight to the model". */
+  const index = new Map<EToolResources | '__direct__', number>();
+
+  for (const { file, option } of routed) {
+    if (option == null) {
+      rejected.push(file);
+      continue;
+    }
+    const key = option.toolResource ?? '__direct__';
+    const at = index.get(key);
+    if (at == null) {
+      index.set(key, groups.length);
+      groups.push({ toolResource: option.toolResource, files: [file] });
+    } else {
+      groups[at].files.push(file);
+    }
+  }
+
+  return { groups, rejected };
+}
