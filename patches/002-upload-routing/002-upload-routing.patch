+
+    act(() => dropSpec?.drop({ files: [png()] }));
+
+    expect(mockShowToast).not.toHaveBeenCalled();
+    expect(result.current.showModal).toBe(true);
+  });
+
+  it('falls back to the direct upload for unmatched files when nothing is configured', () => {
+    const { result } = setup();
+
+    /**
+     * openAI takes images and PDFs; a CSV leaves nothing on offer. But with no
+     * `uploadMethods` configured anywhere, upstream sent exactly this drop
+     * straight to `handleFiles` — and an unconfigured install must keep
+     * behaving like upstream. Rejecting here was the regression.
+     */
+    act(() => dropSpec?.drop({ files: [csv()] }));
+
+    expect(mockHandleFiles).toHaveBeenCalledWith([expect.objectContaining({ name: 'table.csv' })]);
+    expect(result.current.showModal).toBe(false);
+    expect(mockShowToast).not.toHaveBeenCalled();
+  });
+
+  it('rejects unmatched files once any uploadMethods block is configured', () => {
+    const { result } = setup({ uploadMethods: { provider: true } });
+
+    /** The same CSV, but the deployment opted into routing: now it is a decision. */
+    act(() => dropSpec?.drop({ files: [csv()] }));
+
+    expect(mockHandleFiles).not.toHaveBeenCalled();
+    expect(result.current.showModal).toBe(false);
+    expect(mockShowToast).toHaveBeenCalledWith({
+      message: 'com_ui_upload_no_options',
+      status: 'error',
