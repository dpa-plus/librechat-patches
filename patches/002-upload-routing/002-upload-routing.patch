@@ -0,0 +1,214 @@
+import React from 'react';
+import { RecoilRoot } from 'recoil';
+import { render, screen } from '@testing-library/react';
+import { AgentCapabilities, EModelEndpoint, EToolResources } from 'librechat-data-provider';
+import type { EndpointFileConfig, TUploadMethods } from 'librechat-data-provider';
+import DragDropModal from '../DragDropModal';
+
+/**
+ * The dialog must render exactly what `getAvailableUploadOptions` returns for the
+ * dropped files — no locally derived condition, no leftover "Upload Image"
+ * fallback when the direct branch is opted out.
+ */
+
+const translations: Record<string, string> = {
+  com_ui_upload_type: 'Select Upload Type',
+  com_ui_upload_provider: 'Upload to Provider',
+  com_ui_upload_image_input: 'Upload Image',
+  com_ui_upload_ocr_text: 'Upload as Text',
+  com_ui_upload_file_search: 'Upload for File Search',
+  com_ui_upload_code_environment: 'Upload to Code Environment',
+};
+
+jest.mock('~/hooks', () => ({
+  useLocalize: () => (key: string) => translations[key] || key,
+}));
+
+jest.mock('@librechat/client', () => {
+  // eslint-disable-next-line @typescript-eslint/no-require-imports
+  const R = require('react');
+  return {
+    OGDialog: (props: { children: React.ReactNode }) =>
+      R.createElement('div', null, props.children),
+    OGDialogTemplate: (props: { title: string; main: React.ReactNode }) =>
+      R.createElement('div', null, R.createElement('h2', null, props.title), props.main),
+  };
+});
+
+let mockDragDropContext: Record<string, unknown> = {};
+jest.mock('~/Providers', () => ({
+  useDragDropContext: () => mockDragDropContext,
+}));
+
+let mockAgentsCapabilities: AgentCapabilities[] = [];
+jest.mock('~/hooks/Agents/useGetAgentsConfig', () => ({
+  __esModule: true,
+  default: () => ({ agentsConfig: { capabilities: mockAgentsCapabilities } }),
+}));
+
+let mockAgentPermissions = {
+  fileSearchAllowedByAgent: false,
+  codeAllowedByAgent: false,
+  provider: undefined as string | undefined,
+};
+jest.mock('~/hooks/Agents/useAgentToolPermissions', () => ({
+  __esModule: true,
+  default: () => mockAgentPermissions,
+}));
+
+let mockStartupConfig: Record<string, unknown> | undefined;
+/** `undefined` models the window in which the file-config query is still in flight. */
+let mockFileConfigData: Record<string, unknown> | undefined = {};
+jest.mock('~/data-provider', () => ({
+  useGetStartupConfig: () => ({ data: mockStartupConfig }),
+  useGetFileConfig: () => ({ data: mockFileConfigData }),
+}));
+
+const file = (name: string, type: string) => ({ name, type }) as File;
+const png = () => file('photo.png', 'image/png');
+const pdf = () => file('doc.pdf', 'application/pdf');
+
+const onOptionSelect = jest.fn();
+const setShowModal = jest.fn();
+
+function modalElement(files: File[]) {
+  return (
+    <RecoilRoot>
+      <DragDropModal
+        files={files}
+        isVisible={true}
+        setShowModal={setShowModal}
+        onOptionSelect={onOptionSelect}
+      />
+    </RecoilRoot>
+  );
+}
+
+function renderModal({
+  files = [png()],
+  endpoint = EModelEndpoint.openAI as string,
+  provider,
+  uploadMethods,
+  capabilities = [] as AgentCapabilities[],
+  fileConfigLoading = false,
+}: {
+  files?: File[];
+  endpoint?: string;
+  provider?: string;
+  uploadMethods?: TUploadMethods;
+  capabilities?: AgentCapabilities[];
+  fileConfigLoading?: boolean;
+} = {}) {
+  mockAgentsCapabilities = capabilities;
+  mockAgentPermissions = { ...mockAgentPermissions, provider };
+  mockDragDropContext = {
+    conversationId: 'convo-1',
+    agentId: undefined,
+    endpoint,
+    endpointType: undefined,
+    useResponsesApi: undefined,
+    spec: undefined,
+    endpointFileConfig: { uploadMethods } as EndpointFileConfig,
+  };
+  mockStartupConfig = undefined;
+  mockFileConfigData = fileConfigLoading ? undefined : {};
+
+  return { ...render(modalElement(files)), files };
+}
+
+beforeEach(() => {
+  onOptionSelect.mockClear();
+  setShowModal.mockClear();
+  mockFileConfigData = {};
+  mockAgentPermissions = {
+    fileSearchAllowedByAgent: false,
+    codeAllowedByAgent: false,
+    provider: undefined,
+  };
+});
+
+describe('DragDropModal', () => {
+  it('renders the provider option for acceptable files', () => {
+    renderModal({ files: [png(), pdf()] });
+    expect(screen.getByText('Upload to Provider')).toBeInTheDocument();
+  });
+
+  it('renders nothing from the direct branch on provider:false', () => {
+    renderModal({ uploadMethods: { provider: false } });
+    expect(screen.queryByText('Upload to Provider')).not.toBeInTheDocument();
+    /** No swap to the image variant — that would be the same upload, relabelled. */
+    expect(screen.queryByText('Upload Image')).not.toBeInTheDocument();
+  });
+
+  it('renders no image fallback on provider:false for image-only providers', () => {
+    renderModal({ endpoint: EModelEndpoint.azureOpenAI, uploadMethods: { provider: false } });
+    expect(screen.queryByText('Upload Image')).not.toBeInTheDocument();
+  });
+
+  it('omits options the dropped files do not fit', () => {
+    renderModal({ endpoint: EModelEndpoint.azureOpenAI, files: [pdf()] });
+    expect(screen.queryByText('Upload Image')).not.toBeInTheDocument();
+    expect(screen.queryByRole('button')).not.toBeInTheDocument();
+  });
+
+  it('closes itself instead of showing an empty dialog when nothing is available', () => {
+    renderModal({
+      uploadMethods: { provider: false, context: false },
+      capabilities: [AgentCapabilities.context],
+    });
+    expect(screen.queryByRole('button')).not.toBeInTheDocument();
+    /** A visible dialog with no buttons is a dead end; it has to close. */
+    expect(screen.queryByText('Select Upload Type')).not.toBeInTheDocument();
+    expect(setShowModal).toHaveBeenCalledWith(false);
+  });
+
+  it('closes when the list empties out while the dialog is already open', () => {
+    const { rerender, files } = renderModal({ capabilities: [AgentCapabilities.context] });
+    expect(screen.getByText('Upload to Provider')).toBeInTheDocument();
+    expect(setShowModal).not.toHaveBeenCalled();
+
+    /** A config that only lands after the drop, e.g. a late query resolution. */
+    mockDragDropContext = {
+      ...mockDragDropContext,
+      endpointFileConfig: {
+        uploadMethods: { provider: false, context: false },
+      } as EndpointFileConfig,
+    };
+    rerender(modalElement(files));
+
+    expect(screen.queryByRole('button')).not.toBeInTheDocument();
+    expect(screen.queryByText('Select Upload Type')).not.toBeInTheDocument();
+    expect(setShowModal).toHaveBeenCalledWith(false);
+  });
+
+  it('shows no dialog while the file config is still loading', () => {
+    renderModal({ fileConfigLoading: true });
+    /** Not knowing the config is not the same as knowing it allows everything. */
+    expect(screen.queryByText('Upload to Provider')).not.toBeInTheDocument();
+    expect(screen.queryByText('Select Upload Type')).not.toBeInTheDocument();
+  });
+
+  it('hides "Upload as Text" on context:false but keeps the direct option', () => {
+    renderModal({
+      uploadMethods: { context: false },
+      capabilities: [AgentCapabilities.context],
+    });
+    expect(screen.getByText('Upload to Provider')).toBeInTheDocument();
+    expect(screen.queryByText('Upload as Text')).not.toBeInTheDocument();
+  });
+
+  it('passes the tool resource of the picked option to the callback', () => {
+    renderModal({
+      uploadMethods: { provider: false },
+      capabilities: [AgentCapabilities.context],
+    });
+    screen.getByText('Upload as Text').click();
+    expect(onOptionSelect).toHaveBeenCalledWith(EToolResources.context);
+  });
+
+  it('passes undefined for the direct option', () => {
+    renderModal();
+    screen.getByText('Upload to Provider').click();
+    expect(onOptionSelect).toHaveBeenCalledWith(undefined);
+  });
+});
