+import React from 'react';
+import {
+  FileSearch,
+  ImageUpIcon,
+  FileType2Icon,
+  FileImageIcon,
+  TerminalSquareIcon,
+} from 'lucide-react';
+import { UploadOptionType } from 'librechat-data-provider';
+import type { TranslationKeys } from '~/hooks/useLocalize';
+
+/**
+ * Label and icon for each upload option.
+ *
+ * Which options exist is decided by `getAvailableUploadOptions`; this map is the
+ * presentation half of it, shared by the attachment menu and the drag-and-drop
+ * dialog so both stay labelled identically.
+ */
+export const uploadOptionPresentation: Record<
+  UploadOptionType,
+  { labelKey: TranslationKeys; icon: React.JSX.Element }
+> = {
+  [UploadOptionType.provider]: {
+    labelKey: 'com_ui_upload_provider',
+    icon: <FileImageIcon className="icon-md" />,
+  },
+  [UploadOptionType.image]: {
+    labelKey: 'com_ui_upload_image_input',
+    icon: <ImageUpIcon className="icon-md" />,
+  },
+  [UploadOptionType.context]: {
+    labelKey: 'com_ui_upload_ocr_text',
+    icon: <FileType2Icon className="icon-md" />,
+  },
+  [UploadOptionType.file_search]: {
+    labelKey: 'com_ui_upload_file_search',
+    icon: <FileSearch className="icon-md" />,
+  },
+  [UploadOptionType.execute_code]: {
+    labelKey: 'com_ui_upload_code_environment',
+    icon: <TerminalSquareIcon className="icon-md" />,
+  },
+};
