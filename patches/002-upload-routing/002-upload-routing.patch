+import { useMemo, useRef, useCallback } from 'react';
+import { useRecoilValue } from 'recoil';
+import {
+  Constants,
+  defaultAgentCapabilities,
+  getAvailableUploadOptions,
+  resolveUploadForFile,
+  shouldAutoRoute,
+} from 'librechat-data-provider';
+import type {
+  EModelEndpoint,
+  EndpointFileConfig,
+  UploadOption,
+  UploadOptionsParams,
+} from 'librechat-data-provider';
+import useAgentToolPermissions from '~/hooks/Agents/useAgentToolPermissions';
+import useAgentCapabilities from '~/hooks/Agents/useAgentCapabilities';
+import useGetAgentsConfig from '~/hooks/Agents/useGetAgentsConfig';
+import useUploadMethods from './useUploadMethods';
+import { ephemeralAgentByConvoId } from '~/store';
+
+export interface UseUploadOptionsParams {
+  conversationId?: string | null;
+  agentId?: string | null;
+  endpoint?: string | null;
+  endpointType?: EModelEndpoint | string | null;
+  useResponsesApi?: boolean;
+  /** Name of the active model spec, if the conversation was started from one. */
+  spec?: string | null;
+  endpointFileConfig?: EndpointFileConfig | null;
+  /** Concrete files, when already known (drag and drop). */
+  files?: File[] | null;
+}
+
+/**
+ * `unknown` and `empty` are different answers and must not be collapsed.
+ *
+ * - `loading`: the configuration the options are derived from has not arrived
+ *   yet. Neither offering nor rejecting is correct; offering would walk past a
+ *   configuration that may well remove the option, rejecting would be a false
+ *   refusal for a configuration that allows it. Callers wait.
+ * - `ready`: the list is authoritative. Empty then genuinely means "nothing on
+ *   offer for these files", and callers must reject.
+ * - `unavailable`: the configuration failed to load and will not arrive. Nothing
+ *   can be offered, so `options` is empty and callers reject — waiting further
+ *   would strand them. Only `loading` means "wait"; every other status is a
+ *   decision, which is why callers only ever branch on `loading`.
+ */
+export type UploadOptionsStatus = 'loading' | 'ready' | 'unavailable';
+
+export interface UploadOptionsResult {
+  status: UploadOptionsStatus;
+  /** Only populated for `'ready'`; empty for both other states. */
+  options: UploadOption[];
+}
+
+/** One file and the method it should take, or `null` when nothing can take it. */
+export interface RoutedFile {
+  file: File;
+  option: UploadOption | null;
+}
+
+export interface RouteResult {
+  status: UploadOptionsStatus;
+  /** Only populated for `'ready'`. */
+  routed: RoutedFile[];
+}
+
+export interface UseUploadOptionsResult extends UploadOptionsResult {
+  /**
+   * Same computation for a set of files that is only known at event time, e.g.
+   * inside a drop or paste handler. Stable across renders, reads the latest
+   * inputs from a ref, so it never forces the drop target to be re-created.
+   *
+   * Omitting the files (or passing `null`) asks the same question without the
+   * file-type filter: which options does the *configuration* allow. The paste
+   * path needs exactly that, since it never had a type check to begin with.
+   */
+  getOptionsForFiles: (files?: File[] | null) => UploadOptionsResult;
+  /**
+   * `true` when the deployment asked for the choice to be made for the user.
+   * Off unless configured, so an unconfigured instance keeps upstream's menu.
+   */
+  autoRoute: boolean;
+  /**
+   * Resolves each file to its own method. Routing per file matters: a drop can
+   * mix a spreadsheet and a PDF, and those do not belong on the same path.
+   */
+  getRouteForFiles: (files: File[]) => RouteResult;
+  /**
+   * `true` when at least one `uploadMethods` block is configured (spec or
+   * endpoint). With `false`, the deployment never opted into routing, and the
+   * zero-options rejection must not fire: upstream would have uploaded such a
+   * drop directly, and an unconfigured install has to keep doing exactly that
+   * (the contract in the patch README). Only meaningful once `status` is
+   * `ready` — before that both sources are still indistinguishable from unset.
+   */
+  hasRoutingConfig: boolean;
+}
+
+const noOptions: UploadOption[] = [];
+const loadingResult: UploadOptionsResult = { status: 'loading', options: noOptions };
+const unavailableResult: UploadOptionsResult = { status: 'unavailable', options: noOptions };
+
+/**
+ * Wires the shared {@link getAvailableUploadOptions} up to the hooks that supply
+ * its inputs, so the attachment menu, the drop handler, the drop dialog and the
+ * paste handler all derive their options from identical data.
+ *
+ * Previously each of them assembled its own conditions, which is how the
+ * `uploadMethods` opt-out ended up bypassable by dropping or pasting files.
+ */
+export default function useUploadOptions({
+  conversationId,
+  agentId,
+  endpoint,
+  endpointType,
+  useResponsesApi,
+  spec,
+  endpointFileConfig,
+  files,
