+import React from 'react';
+import { RecoilRoot } from 'recoil';
+import { act, renderHook } from '@testing-library/react';
+import { AgentCapabilities, EModelEndpoint } from 'librechat-data-provider';
+import type { EndpointFileConfig, TUploadMethods } from 'librechat-data-provider';
+import useTextarea from './useTextarea';
+
+/**
+ * Regression suite for the clipboard path.
+ *
+ * `handlePaste` used to call `handleFiles` directly, with no `tool_resource` and
+ * no check at all. Pasting was therefore the one conversation upload path that
+ * skipped the `uploadMethods` opt-out the attachment menu and the drop path
