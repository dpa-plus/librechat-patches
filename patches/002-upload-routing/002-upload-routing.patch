+    act(() => dropSpec?.drop({ files: [png()] }));
+
+    expect(mockHandleFiles).not.toHaveBeenCalled();
+    expect(mockShowToast).not.toHaveBeenCalled();
+    expect(result.current.showModal).toBe(true);
+  });
+
+  it('rejects the drop instead of uploading when provider uploads are opted out', () => {
+    const { result } = setup({ uploadMethods: { provider: false } });
+
+    act(() => dropSpec?.drop({ files: [png()] }));
+
+    /** The bypass: this used to reach `handleFiles` directly. */
+    expect(mockHandleFiles).not.toHaveBeenCalled();
+    expect(result.current.showModal).toBe(false);
+    expect(mockShowToast).toHaveBeenCalledWith({
+      message: 'com_ui_upload_no_options',
+      status: 'error',
+    });
+  });
+
+  it('honours a model spec opt-out on the drag-and-drop path', () => {
+    setup({
+      spec: 'text-only-spec',
+      specUploadMethods: { provider: false },
+    });
+
+    act(() => dropSpec?.drop({ files: [png()] }));
+
+    expect(mockHandleFiles).not.toHaveBeenCalled();
+    expect(mockShowToast).toHaveBeenCalledWith({
+      message: 'com_ui_upload_no_options',
+      status: 'error',
+    });
+  });
+
+  it('lets a model spec re-enable what the endpoint disabled', () => {
+    const { result } = setup({
+      uploadMethods: { provider: false },
