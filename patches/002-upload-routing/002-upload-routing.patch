+import { renderHook } from '@testing-library/react';
+import { EToolResources } from 'librechat-data-provider';
+import type { RoutedFile } from '../useUploadOptions';
+import useRoutedUpload from '../useRoutedUpload';
+
+const mockShowToast = jest.fn();
+jest.mock('@librechat/client', () => ({
+  useToastContext: () => ({ showToast: mockShowToast }),
+}));
+jest.mock('../../useLocalize', () => ({
+  __esModule: true,
+  default: () => (key: string) => key,
+}));
+
+const file = (name: string) => new File(['x'], name);
+
+const routedTo = (name: string, toolResource?: EToolResources): RoutedFile => ({
+  file: file(name),
+  option: { type: 'provider' as never, toolResource },
+});
+
+describe('useRoutedUpload', () => {
+  let handleFiles: jest.Mock;
+  let setEphemeralAgent: jest.Mock;
+  let setFilesLoading: jest.Mock;
+
+  const setup = () => {
+    handleFiles = jest.fn().mockResolvedValue(undefined);
+    setEphemeralAgent = jest.fn();
+    setFilesLoading = jest.fn();
+    return renderHook(() =>
+      useRoutedUpload({
+        handleFiles,
+        setEphemeralAgent: setEphemeralAgent as never,
+        setFilesLoading,
+      }),
+    ).result;
+  };
+
+  beforeEach(() => mockShowToast.mockClear());
+
+  /**
+   * The clipboard path shipped without this once. The upload reports success and
+   * the file is nowhere, because the agent never got the tool.
+   */
+  it.each([EToolResources.file_search, EToolResources.execute_code])(
+    'arms the ephemeral agent for %s before uploading',
+    async (resource) => {
+      const result = setup();
+      await result.current([routedTo('a.pdf', resource)]);
+
+      expect(setEphemeralAgent).toHaveBeenCalledTimes(1);
+      const updater = setEphemeralAgent.mock.calls[0][0] as (p: object) => object;
+      expect(updater({})).toEqual({ [resource]: true });
+      expect(handleFiles).toHaveBeenCalledWith([expect.any(File)], resource);
+    },
+  );
+
+  it('does not arm anything for a direct upload', async () => {
+    const result = setup();
+    await result.current([routedTo('a.pdf', undefined)]);
+    expect(setEphemeralAgent).not.toHaveBeenCalled();
+    expect(handleFiles).toHaveBeenCalledWith([expect.any(File)], undefined);
+  });
+
+  /**
+   * `validateFiles` counts against the files already in state and `addFile`
+   * lands asynchronously, so parallel groups would each see an empty list and
+   * walk past `fileLimit` one group at a time.
+   */
+  it('uploads the groups one after another, not all at once', async () => {
+    const result = setup();
+    const order: string[] = [];
+    handleFiles.mockImplementation(async (files: File[]) => {
+      order.push(`start:${files[0].name}`);
+      await Promise.resolve();
+      order.push(`end:${files[0].name}`);
+    });
+
+    await result.current([
+      routedTo('a.pdf', undefined),
+      routedTo('b.xlsx', EToolResources.execute_code),
+    ]);
+
+    expect(order).toEqual(['start:a.pdf', 'end:a.pdf', 'start:b.xlsx', 'end:b.xlsx']);
+  });
+
+  it('batches files of the same method into a single call', async () => {
+    const result = setup();
+    await result.current([routedTo('a.pdf', undefined), routedTo('b.pdf', undefined)]);
+    expect(handleFiles).toHaveBeenCalledTimes(1);
+    expect(handleFiles.mock.calls[0][0]).toHaveLength(2);
+  });
+
+  it('rejects without uploading when nothing can be routed', async () => {
+    const result = setup();
+    await result.current([{ file: file('a.zip'), option: null }]);
+
+    expect(handleFiles).not.toHaveBeenCalled();
+    expect(mockShowToast).toHaveBeenCalledWith(
+      expect.objectContaining({ message: 'com_ui_upload_no_options' }),
+    );
+    expect(setFilesLoading).toHaveBeenCalledWith(false);
+  });
+
+  it('names the skipped files when only some of them are unroutable', async () => {
+    const result = setup();
+    await result.current([
+      routedTo('good.pdf', undefined),
+      { file: file('bad.zip'), option: null },
+    ]);
+
+    expect(handleFiles).toHaveBeenCalledTimes(1);
+    expect(mockShowToast).toHaveBeenCalledWith(
+      expect.objectContaining({ message: 'com_ui_upload_no_options_partial' }),
+    );
+  });
+});
+
+describe('useRoutedUpload — limits and the empty set', () => {
+  const setup = (extra: Record<string, unknown> = {}) => {
+    const handleFiles = jest.fn().mockResolvedValue(undefined);
+    const setFilesLoading = jest.fn();
+    const result = renderHook(() =>
+      useRoutedUpload({
+        handleFiles,
+        setEphemeralAgent: jest.fn() as never,
+        setFilesLoading,
+        ...extra,
+      }),
+    ).result;
+    return { result, handleFiles, setFilesLoading };
+  };
+
+  beforeEach(() => mockShowToast.mockClear());
+
+  /**
+   * The reason this is checked here and not left to `validateFiles`: the
+   * `handleFiles` this hook calls carries the file list it closed over, so every
+   * group would be measured against the same starting point.
+   */
+  it('counts the whole drop against fileLimit, not each group', async () => {
+    const { result, handleFiles } = setup({ fileLimit: 3, currentFileCount: 0 });
+    await result.current([
+      routedTo('a.pdf', undefined),
+      routedTo('b.pdf', undefined),
+      routedTo('c.xlsx', EToolResources.execute_code),
+      routedTo('d.xlsx', EToolResources.execute_code),
+    ]);
+
+    expect(handleFiles).not.toHaveBeenCalled();
+    expect(mockShowToast).toHaveBeenCalledWith(
+      expect.objectContaining({ message: expect.stringContaining('File limit reached') }),
+    );
+  });
+
+  it('counts files that are already attached', async () => {
+    const { result, handleFiles } = setup({ fileLimit: 3, currentFileCount: 2 });
+    await result.current([routedTo('a.pdf', undefined), routedTo('b.pdf', undefined)]);
+    expect(handleFiles).not.toHaveBeenCalled();
+  });
+
+  it('lets a drop through that fits', async () => {
+    const { result, handleFiles } = setup({ fileLimit: 3, currentFileCount: 0 });
+    await result.current([routedTo('a.pdf', undefined), routedTo('b.pdf', undefined)]);
+    expect(handleFiles).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not check a limit nobody configured', async () => {
+    const { result, handleFiles } = setup();
+    await result.current(Array.from({ length: 40 }, (_, i) => routedTo(`f${i}.pdf`, undefined)));
+    expect(handleFiles).toHaveBeenCalledTimes(1);
+  });
+
+  /**
+   * An unavailable configuration hands over an empty set. Returning quietly
+   * would drop the files with no sign that anything happened — the exact
+   * symptom the routing was meant to remove.
+   */
+  it('says something when the set is empty rather than failing silently', async () => {
+    const { result, handleFiles, setFilesLoading } = setup();
+    await result.current([]);
+
+    expect(handleFiles).not.toHaveBeenCalled();
+    expect(mockShowToast).toHaveBeenCalledWith(
+      expect.objectContaining({ message: 'com_ui_upload_no_options' }),
+    );
+    expect(setFilesLoading).toHaveBeenCalledWith(false);
+  });
+});
+
+describe('useRoutedUpload — total size across groups', () => {
+  const sized = (name: string, bytes: number): RoutedFile => ({
+    file: new File([new Uint8Array(bytes)], name),
+    option: { type: 'provider' as never, toolResource: undefined },
+  });
+  const sizedTo = (name: string, bytes: number, toolResource: EToolResources): RoutedFile => ({
+    file: new File([new Uint8Array(bytes)], name),
+    option: { type: 'provider' as never, toolResource },
+  });
+
+  const setup = (extra: Record<string, unknown> = {}) => {
+    const handleFiles = jest.fn().mockResolvedValue(undefined);
+    const setFilesLoading = jest.fn();
+    const result = renderHook(() =>
+      useRoutedUpload({
+        handleFiles,
+        setEphemeralAgent: jest.fn() as never,
+        setFilesLoading,
+        ...extra,
+      }),
+    ).result;
+    return { result, handleFiles, setFilesLoading };
+  };
+
+  beforeEach(() => mockShowToast.mockClear());
+
+  /**
+   * Two groups of 300 each against a limit of 512: `validateFiles` would
+   * measure both from the same starting point and let 600 through. The hook
+   * preflights the aggregate, exactly like it already does for `fileLimit`.
+   */
+  it('counts the whole drop against totalSizeLimit, not each group', async () => {
+    const { result, handleFiles, setFilesLoading } = setup({ totalSizeLimit: 512 });
+    await result.current([
+      sized('a.pdf', 300),
+      sizedTo('b.xlsx', 300, EToolResources.execute_code),
+    ]);
+
+    expect(handleFiles).not.toHaveBeenCalled();
+    expect(mockShowToast).toHaveBeenCalledWith(
+      expect.objectContaining({ message: expect.stringContaining('Total file size limit') }),
+    );
+    expect(setFilesLoading).toHaveBeenCalledWith(false);
+  });
+
+  it('counts bytes that are already attached', async () => {
+    const { result, handleFiles } = setup({ totalSizeLimit: 512, currentTotalSizeBytes: 400 });
+    await result.current([sized('a.pdf', 200)]);
+    expect(handleFiles).not.toHaveBeenCalled();
+  });
+
+  it('lets a drop through that fits', async () => {
+    const { result, handleFiles } = setup({ totalSizeLimit: 512, currentTotalSizeBytes: 100 });
+    await result.current([sized('a.pdf', 200), sized('b.pdf', 200)]);
+    expect(handleFiles).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not check a limit nobody configured', async () => {
+    const { result, handleFiles } = setup();
+    await result.current([sized('a.pdf', 5_000_000)]);
+    expect(handleFiles).toHaveBeenCalledTimes(1);
+  });
+});
