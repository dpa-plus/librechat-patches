+
+      expect(mockHandleFiles).not.toHaveBeenCalled();
+      expect(mockShowToast).toHaveBeenCalledWith(noOptionsToast);
+      /** Otherwise the composer would sit in "files loading" forever. */
+      expect(mockSetFilesLoading).toHaveBeenLastCalledWith(false);
+    });
+
+    it('rejects once a config that removes the direct upload arrives', () => {
+      const { result, rerender } = setup({
+        fileConfigLoading: true,
+        uploadMethods: { provider: false },
+      });
+
+      act(() => result.current.handlePaste(pasteEvent([pngFile()])));
+      expect(mockShowToast).not.toHaveBeenCalled();
+
+      mockFileConfigData = {};
+      act(() => rerender());
+
+      expect(mockHandleFiles).not.toHaveBeenCalled();
+      expect(mockShowToast).toHaveBeenCalledWith(noOptionsToast);
+    });
+  });
+
+  it('ignores a paste without files', () => {
+    const { result } = setup();
+
+    act(() => result.current.handlePaste(pasteEvent([])));
+
+    expect(mockHandleFiles).not.toHaveBeenCalled();
+    expect(mockShowToast).not.toHaveBeenCalled();
+  });
+});
