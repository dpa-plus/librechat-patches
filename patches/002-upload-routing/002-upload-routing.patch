+  const options = useMemo(
+    () => (isReady ? getAvailableUploadOptions({ ...baseParams, files }) : noOptions),
+    [baseParams, files, isReady],
+  );
+
+  let status: UploadOptionsStatus = 'loading';
+  if (isReady) {
+    status = 'ready';
+  } else if (isUnavailable) {
+    status = 'unavailable';
+  }
+
+  const hasRoutingConfig =
+    baseParams.specUploadMethods != null || baseParams.endpointUploadMethods != null;
+
+  return { status, options, getOptionsForFiles, autoRoute, getRouteForFiles, hasRoutingConfig };
+}
