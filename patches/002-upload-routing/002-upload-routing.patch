+  __esModule: true,
+  default: () => ({ handleFiles: mockHandleFiles }),
+}));
+
+jest.mock('~/hooks', () => ({
+  useLocalize: () => (key: string) => key,
+}));
+
+jest.mock('~/hooks/Conversations/useGetSender', () => ({
+  __esModule: true,
+  default: () => () => 'AI',
+}));
+
+jest.mock('~/hooks/Messages/useLatestMessage', () => ({
+  useLatestMessage: () => undefined,
+}));
+
+jest.mock('~/Providers/AgentsMapContext', () => ({
+  useAgentsMapContext: () => undefined,
+}));
+
+jest.mock('~/Providers/AssistantsMapContext', () => ({
+  useAssistantsMapContext: () => undefined,
+}));
+
+const mockSetFilesLoading = jest.fn();
+jest.mock('~/Providers/ChatContext', () => ({
+  useChatContext: () => ({
+    index: 0,
+    conversation: { conversationId: 'convo-1', endpoint: 'openAI' },
+    isSubmitting: false,
+    filesLoading: false,
+    setFilesLoading: mockSetFilesLoading,
+  }),
+}));
+
+let mockDragDropContext: Record<string, unknown> = {};
+jest.mock('~/Providers/DragDropContext', () => ({
+  useDragDropContext: () => mockDragDropContext,
+}));
+
+let mockAgentsCapabilities: AgentCapabilities[] = [];
+jest.mock('~/hooks/Agents/useGetAgentsConfig', () => ({
+  __esModule: true,
+  default: () => ({ agentsConfig: { capabilities: mockAgentsCapabilities } }),
+}));
+
+jest.mock('~/hooks/Agents/useAgentToolPermissions', () => ({
+  __esModule: true,
+  default: () => ({
+    fileSearchAllowedByAgent: true,
+    codeAllowedByAgent: false,
+    provider: undefined,
