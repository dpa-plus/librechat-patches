index 0000000..8a77300
--- /dev/null
+++ b/client/src/utils/tableClipboard.spec.ts
@@ -0,0 +1,32 @@
+import { tableToTsv, tableToCleanHtml } from './tableClipboard';
+
+const build = (html: string): HTMLTableElement => {
+  const host = document.createElement('div');
+  host.innerHTML = html;
+  return host.querySelector('table') as HTMLTableElement;
+};
+
+describe('tableToTsv', () => {
+  it('joins cells with tabs and rows with newlines', () => {
+    const t = build(
+      '<table><thead><tr><th>Raum</th><th>Fläche</th></tr></thead>' +
+        '<tbody><tr><td>01.01</td><td>64,17</td></tr></tbody></table>',
+    );
+    expect(tableToTsv(t)).toBe('Raum\tFläche\n01.01\t64,17');
+  });
+
+  it('collapses inner whitespace so a wrapped cell stays one field', () => {
+    const t = build('<table><tr><td>Büro  Kreisbrand.\n+ Ärztl. Leiter</td></tr></table>');
+    expect(tableToTsv(t)).toBe('Büro Kreisbrand. + Ärztl. Leiter');
+  });
+});
+
+describe('tableToCleanHtml', () => {
+  it('drops renderer attributes but keeps structure and spans', () => {
+    const t = build(
+      '<table class="w-full" style="color:red"><tr><td colspan="2" class="p-2">a</td></tr></table>',
+    );
+    const html = tableToCleanHtml(t);
+    expect(html).toBe('<table><tbody><tr><td colspan="2">a</td></tr></tbody></table>');
+  });
+});
diff --git a/client/src/utils/tableClipboard.ts b/client/src/utils/tableClipboard.ts
new file mode 100644
index 0000000..46f5641
--- /dev/null
+++ b/client/src/utils/tableClipboard.ts
@@ -0,0 +1,61 @@
+/**
+ * Serializes a rendered markdown table for the clipboard.
+ *
+ * The whole point is writing BOTH flavours in one clipboard item: `text/html`
+ * is what lets Excel and Word paste a real table, tab-separated `text/plain`
+ * is what a code editor or a terminal gets. Selecting the table by hand copies
+ * only the plain text run together, which is exactly the complaint this
+ * addresses.
+ */
+
+export function tableToTsv(table: HTMLTableElement): string {
+  const rows: string[] = [];
+  for (const row of Array.from(table.rows)) {
+    const cells = Array.from(row.cells).map((cell) =>
+      (cell.innerText || cell.textContent || '').replace(/\s+/g, ' ').trim(),
+    );
+    rows.push(cells.join('\t'));
+  }
+  return rows.join('\n');
+}
+
+/**
+ * A stripped copy of the table: layout classes from the renderer mean nothing
+ * outside the app and make Word render a mess. Structure and text stay,
+ * attributes go.
+ */
+export function tableToCleanHtml(table: HTMLTableElement): string {
+  const clone = table.cloneNode(true) as HTMLTableElement;
+  const strip = (el: Element) => {
+    for (const attr of Array.from(el.attributes)) {
+      if (attr.name !== 'colspan' && attr.name !== 'rowspan') {
+        el.removeAttribute(attr.name);
+      }
+    }
+    for (const child of Array.from(el.children)) {
+      strip(child);
+    }
+  };
+  strip(clone);
+  return clone.outerHTML;
+}
+
+export async function copyTableToClipboard(table: HTMLTableElement): Promise<void> {
+  const tsv = tableToTsv(table);
+  const html = tableToCleanHtml(table);
+
+  if (typeof ClipboardItem !== 'undefined' && navigator.clipboard?.write) {
+    try {
+      await navigator.clipboard.write([
+        new ClipboardItem({
+          'text/html': new Blob([html], { type: 'text/html' }),
+          'text/plain': new Blob([tsv], { type: 'text/plain' }),
+        }),
+      ]);
+      return;
+    } catch {
+      /* Safari without the permission, or an insecure context — fall through. */
+    }
+  }
+  await navigator.clipboard.writeText(tsv);
+}
