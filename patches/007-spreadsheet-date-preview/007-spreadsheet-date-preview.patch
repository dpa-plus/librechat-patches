+/** Enable formatted date cells in spreadsheet previews without changing the
+ * upstream rendering path for deployments that do not opt in. */
+function shouldFormatSpreadsheetDates(): boolean {
+  const value = process.env.SPREADSHEET_PREVIEW_FORMAT_DATES;
+  return value != null && /^(1|true|yes)$/i.test(value.trim());
+}
+
+/**
+ * SheetJS does not preserve formatted date text for all valid Excel formats.
+ * In particular, literal dots in formats such as `DD.MM.YYYY HH:MM` are not
+ * accepted by its SSF formatter unless they are escaped. Without an explicit
+ * display value, `sheet_to_html` falls back to the underlying Excel serial.
+ */
+function formatWorkbookDateCells(
+  workbook: import('xlsx').WorkBook,
+  XLSX: typeof import('xlsx'),
+): void {
+  for (const sheetName of workbook.SheetNames) {
+    const worksheet = workbook.Sheets[sheetName];
+    for (const [address, cell] of Object.entries(worksheet)) {
+      if (address.startsWith('!') || cell?.t !== 'd' || !(cell.v instanceof Date)) {
+        continue;
+      }
+      if (typeof cell.z !== 'string' || cell.z.length === 0) {
+        continue;
+      }
+      const safeFormat = cell.z.replace(/(?<!\\)\./g, '\\.');
+      try {
+        cell.w = XLSX.SSF.format(safeFormat, cell.v);
+      } catch {
+        // Keep SheetJS' readable default for uncommon/unsupported formats.
+      }
+    }
+  }
+}
