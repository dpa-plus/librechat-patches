diff --git a/client/src/components/Chat/Input/ReasoningToggle.tsx b/client/src/components/Chat/Input/ReasoningToggle.tsx
new file mode 100644
index 0000000..f88d56e
--- /dev/null
+++ b/client/src/components/Chat/Input/ReasoningToggle.tsx
@@ -0,0 +1,47 @@
+import React, { memo, useCallback } from 'react';
+import { Lightbulb } from 'lucide-react';
+import { CheckboxButton } from '@librechat/client';
+import { ReasoningEffort } from 'librechat-data-provider';
+import { useLocalize, useSetIndexOptions } from '~/hooks';
+import { useGetStartupConfig } from '~/data-provider';
+import { useChatContext } from '~/Providers';
+
+/**
+ * Patch 005. A composer badge that sets `reasoning_effort: high` on the
+ * conversation — the same field the (spec-hidden) parameters panel would set,
+ * so the existing request pipeline carries it to the provider unchanged.
+ * Off unless the deployment sets `interface.reasoningToggle: true`; unset
+ * renders nothing, exactly upstream behavior.
+ */
+function ReasoningToggle() {
+  const localize = useLocalize();
+  const { conversation } = useChatContext();
+  const { setOption } = useSetIndexOptions();
+  const { data: startupConfig } = useGetStartupConfig();
+
+  const checked = conversation?.reasoning_effort === ReasoningEffort.high;
+
+  const handleChange = useCallback(
+    ({ value }: { value: boolean }) => {
+      setOption('reasoning_effort')(value ? ReasoningEffort.high : null);
+    },
+    [setOption],
+  );
+
+  if (startupConfig?.interface?.reasoningToggle !== true) {
+    return null;
+  }
+
+  return (
+    <CheckboxButton
+      className="max-w-fit"
+      checked={checked}
+      setValue={handleChange}
+      label={localize('com_ui_reasoning_toggle')}
+      isCheckedClassName="border-amber-600/40 bg-amber-500/10 hover:bg-amber-700/10"
+      icon={<Lightbulb className="icon-md" aria-hidden="true" />}
+    />
+  );
+}
+
+export default memo(ReasoningToggle);
