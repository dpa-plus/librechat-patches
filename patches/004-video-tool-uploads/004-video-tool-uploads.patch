+describe('providerVideoAudio through the config pipeline', () => {
+  it('is accepted by the strict schema and survives endpoint resolution', () => {
+    expect(uploadMethodsSchema.parse({ providerVideoAudio: true })).toEqual({
+      providerVideoAudio: true,
+    });
+
+    const merged = mergeFileConfig({
+      endpoints: { Cortecs: { uploadMethods: { providerVideoAudio: true } } },
+    });
+    const endpointConfig = getEndpointFileConfig({
+      fileConfig: merged,
+      endpoint: 'Cortecs',
+      endpointType: EModelEndpoint.custom,
+    });
+
+    expect(endpointConfig.uploadMethods).toEqual({ providerVideoAudio: true });
+  });
+
+  it('is off unless something explicitly enables it', () => {
+    expect(isProviderVideoAudioEnabled()).toBe(false);
+    expect(isProviderVideoAudioEnabled({}, {})).toBe(false);
+  });
+
+  it('uses the endpoint value when the model spec does not configure it', () => {
+    expect(isProviderVideoAudioEnabled(undefined, { providerVideoAudio: true })).toBe(true);
+  });
+
+  it('lets the model spec override the endpoint in either direction', () => {
+    expect(
+      isProviderVideoAudioEnabled({ providerVideoAudio: false }, { providerVideoAudio: true }),
+    ).toBe(false);
+    expect(
+      isProviderVideoAudioEnabled({ providerVideoAudio: true }, { providerVideoAudio: false }),
+    ).toBe(true);
+  });
+});
